{
  "name": "dsh-model-shelf",
  "version": "1.6.0",
  "private": true,
  "publishConfig": { "access": "restricted" },
  "description": "Model Shelf for DSH: a wide, collapsible model picker with a manually organized uncommon list and explicit provider/model identity.",
  "author": { "name": "Hobartoakes", "url": "https://github.com/Hobartoakes" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Hobartoakes/dsh-model-shelf.git" },
  "homepage": "https://github.com/Hobartoakes/dsh-model-shelf#readme",
  "bugs": { "url": "https://github.com/Hobartoakes/dsh-model-shelf/issues" },
  "engines": { "dsh": ">=0.0.1-rc.5 <0.3.0-0" },
  "keywords": ["dsh-plugin", "deepseek-harness", "model-picker", "model-management", "ui"],
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": [
    "lib", "src", "scripts/build.mjs", "scripts/check-release.mjs", "tests/*.mjs", "tests/host-inventory/matrix.json", "tests/host-inventory/early-pins.json",
    "tests/host-inventory/run-contracts.mjs", "tests/host-inventory/seat-fixture.mjs", "tests/host-inventory/web-fixture.mjs", "tests/host-inventory/boot-settlement.mjs",
    "docs/images/*.png", "docs/ICON-ATTRIBUTIONS.md", "docs/research/2026-11-01-brand-icon-permissions.md", "docs/research/2026-11-09-retained-brand-distribution.md", "docs/research/2026-11-01-icon-performance.md", "docs/RELEASE-CHECKLIST.md", "docs/PRIVACY.md", "docs/VALIDATION.md", "docs/HOST-COMPATIBILITY.md", "docs/WORKBUDDY-PROBE.md",
    "cordis.patch.yml", "README.md", "CHANGELOG.md", "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:hosts": "node tests/host-inventory/run-contracts.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:clean-profile": "node tests/clean-profile.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepublishOnly": "node scripts/check-release.mjs --publish"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-model-selection", "@deepseek-ai/dsh-client-ui-slots"],
      "platform": "web"
    }
  },
  "devDependencies": {
    "cordis-rc": "npm:@deepseek-ai/cordis@4.0.5",
    "cordis-alpha": "npm:@deepseek-ai/cordis@4.0.6-alpha.1",
    "cordis-current": "npm:@deepseek-ai/cordis@4.1.0",
    "playwright-core": "1.64.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "immer": "10.1.1",
    "zustand": "4.5.7"
  }
}
